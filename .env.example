# ── LEU* Bot configuration ────────────────────────────────────────────────
# Copy this file to ".env" and fill in the values, then `npm start`.

# Your bot token  (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Your application/client ID  (Developer Portal → General Information → Application ID)
CLIENT_ID=

# Your server (guild) ID  (right-click your server icon → Copy Server ID; requires Developer Mode)
GUILD_ID=

# Optional: a brand colour for embeds (hex without the #). Default is LEU fire-orange.
BRAND_COLOR=FF6A00

# Optional: community display name shown in embeds/panels
COMMUNITY_NAME=Light 'Em Up Gaming

# Optional: logo shown on EVERY embed. Paste a direct image URL (e.g. upload the
# logo to a Discord channel, right-click → Copy Link). If left blank, the bot uses
# its own avatar — so just run `npm run avatar` after dropping assets/logo.png in.
LOGO_URL=
